model {
  extend egress {
    egress_app = service {
      title 'Egress Application'
      description 'Application to ensure only the data that has been approved to move is what is moving'
    }
    
    keycloak = component {
      title 'Keycloak'
      description 'Authenticates requests throughout the layer'
      icon https://upload.wikimedia.org/wikipedia/commons/2/29/Keycloak_Logo.png
    }
  }
}

views {
  view egress of egress {
    title 'Egress / Egress Service'
    include *
  }
}
