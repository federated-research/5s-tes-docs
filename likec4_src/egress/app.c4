model {
  extend egress.egress_app {
    egress_ui = component {
      title 'Egress UI'
      description 'UI for for managing egress'
      icon /logos/5s-tes-logo.svg

      -> egress_api 
    }

    egress_api = component {
      title 'Egress API'
      description 'Backend for managing egress, handles movement of data and notification of relevant users'
      icon /logos/5s-tes-logo.svg

      -> egress_ui
      -> tre.tre_api 'Send approve / reject signal'
    }
  }
}

views {
  view egress_app of egress.egress_app {
    title 'Egress / Egress App'
    include *
  }
}
