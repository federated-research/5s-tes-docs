model {
  extend submission.submission_app {
    sub_ui = component {
      title 'Submission UI'
      description 'User facing application for job submission and result viewing'
      icon /logos/5s-tes-logo.svg

      -> sub_api
    }
      
    sub_api = component {
      title 'Submission API'
      description 'Backend for submission processes, handles user side data management and requests job dispatch'
      icon /logos/5s-tes-logo.svg

      -> sub_ui

      -> submission.postgres 'Stores / retrieves data'
      -> submission.s3 'Stores / retrieves inputs and approved results'
      -> submission.rabbitmq 'Sends job message'
    }
  }
}

views {
  view submission_app of submission.submission_app {
    title 'Submission / Submission App'
    include *
  }
}
