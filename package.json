{
  "name": "5s-tes-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next --turbopack",
    "predev": "npm run likec4:codegen",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "postbuild": "pagefind --site .next/server/app --output-path out/_pagefind",
    "likec4:codegen": "likec4 codegen react likec4_src -o likec4_react/likec4.generated.js",
    "likec4:export": "npx playwright install && likec4 export png likec4_src -o public/images/likec4",
    "likec4:dev": "likec4 start likec4_src"
  },
  "dependencies": {
    "@likec4/core": "1.59.2",
    "likec4": "1.59.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "postcss": "^8.5.21",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "temporal-polyfill": "^1.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}